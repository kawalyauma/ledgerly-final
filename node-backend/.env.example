NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgresql://ledgerly:change-me@127.0.0.1:5432/ledgerly
DATABASE_POOL_MAX=20
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ledgerly
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=ledgerly
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Keep these aligned with the Cloudflare fallback during the hybrid transition.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=your-finance-pro
JWT_AUDIENCE=your-finance-pro-api
CORS_ORIGINS=http://localhost:5173

QUEUE_POLL_MS=1000
QUEUE_BATCH_SIZE=20
QUEUE_STALE_SECONDS=300
SCHEDULER_TIMEZONE=Africa/Kampala

# Required before a school can enable the SchoolPay gateway. Use a separate random secret.
SCHOOLPAY_API_BASE_URL=https://schoolpay.co.ug
# Public HTTPS origin of this Ledgerly API, used to build SchoolPay ad-hoc callback URLs.
SCHOOLPAY_PUBLIC_BASE_URL=https://ledgerly.example.com
SCHOOLPAY_SECRET_ENCRYPTION_KEY=replace-with-a-separate-32-plus-character-random-secret
