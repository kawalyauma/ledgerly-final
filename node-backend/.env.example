NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgresql://ledgerly:change-me@127.0.0.1:5432/ledgerly
DATABASE_POOL_MAX=20
DATABASE_SSL=false

REDIS_URL=redis://127.0.0.1:6379

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ledgerly
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=ledgerly
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=ledgerly
JWT_AUDIENCE=ledgerly-api
CORS_ORIGINS=http://localhost:5173

QUEUE_POLL_MS=1000
QUEUE_BATCH_SIZE=20
QUEUE_STALE_SECONDS=300
SCHEDULER_TIMEZONE=Africa/Kampala
