NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgresql://ledgerly:change-me@127.0.0.1:5432/ledgerly
DATABASE_POOL_MAX=20
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ledgerly
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=ledgerly
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=your-finance-pro
JWT_AUDIENCE=your-finance-pro-api
CORS_ORIGINS=http://localhost:5173

QUEUE_POLL_MS=1000
QUEUE_BATCH_SIZE=20
QUEUE_STALE_SECONDS=300
SCHEDULER_TIMEZONE=Africa/Kampala

SCHOOLPAY_API_BASE_URL=https://schoolpay.co.ug
SCHOOLPAY_PUBLIC_BASE_URL=https://ledgerly.example.com
SCHOOLPAY_SECRET_ENCRYPTION_KEY=replace-with-a-separate-32-plus-character-random-secret
SCHOOLPAY_ENFORCE_WEBHOOK_IP_ALLOWLIST=false
SCHOOLPAY_WEBHOOK_IP_ALLOWLIST=
SCHOOLPAY_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Existing Agentic Employees compatibility settings remain during migration.
RESPONSE_INTELLIGENCE_URL=http://127.0.0.1:8091
RESPONSE_INTELLIGENCE_TOKEN=replace-with-a-long-random-service-token
RESPONSE_INTELLIGENCE_TIMEOUT_MS=30000

# Ledgerly AI: provider identities are private infrastructure.
# Only Codex CLI and Claude Code CLI are accepted.
LEDGERLY_AI_ENABLED=true
LEDGERLY_AI_DEFAULT_PROVIDER=codex
LEDGERLY_AI_FALLBACK_PROVIDER=claude-code
LEDGERLY_AI_EXECUTION_MODE=docker
LEDGERLY_AI_CODEX_BIN=codex
LEDGERLY_AI_CLAUDE_BIN=claude
LEDGERLY_AI_DOCKER_BIN=docker
LEDGERLY_AI_CODEX_IMAGE=ledgerly-ai-codex:local
LEDGERLY_AI_CLAUDE_IMAGE=ledgerly-ai-claude-code:local
LEDGERLY_AI_SESSION_ROOT=/var/lib/ledgerly-ai/sessions
LEDGERLY_AI_WORK_ROOT=/var/lib/ledgerly-ai/workspaces
LEDGERLY_AI_JOB_TIMEOUT_MS=300000
LEDGERLY_AI_HEALTH_TIMEOUT_MS=10000
LEDGERLY_AI_MAX_CONCURRENCY=4
LEDGERLY_AI_MAX_QUEUE=100
LEDGERLY_AI_USER_REQUESTS_PER_MINUTE=20
LEDGERLY_AI_ORG_REQUESTS_PER_MINUTE=200
LEDGERLY_AI_AGENT_REQUESTS_PER_MINUTE=60
LEDGERLY_AI_CHAT_HISTORY_MESSAGES=30
LEDGERLY_AI_MAX_OUTPUT_BYTES=4194304
LEDGERLY_AI_RETRY_ATTEMPTS=1
LEDGERLY_AI_RETRY_BACKOFF_MS=1000
# 0 means no soft usage cap; set these if subscription limits need protection.
LEDGERLY_AI_CODEX_SOFT_JOBS_PER_HOUR=0
LEDGERLY_AI_CLAUDE_SOFT_JOBS_PER_HOUR=0
LEDGERLY_AI_LOG_PROMPTS=false
LEDGERLY_AI_STARTUP_HEALTHCHECK=true
