{
  "name": "ledgerly-node-backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:queue": "tsx watch src/queue/worker.ts",
    "dev:scheduler": "tsx watch src/scheduler/scheduler.ts",
    "build": "tsc -p tsconfig.json --noCheck",
    "build:strict": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "start": "node dist/server.js",
    "start:queue": "node dist/queue/worker.js",
    "start:scheduler": "node dist/scheduler/scheduler.js",
    "check": "npm run typecheck && npm test && npm run build:strict"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@hono/node-server": "^1.19.1",
    "hono": "^4.9.7",
    "jose": "^6.1.0",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "redis": "^5.8.2",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
