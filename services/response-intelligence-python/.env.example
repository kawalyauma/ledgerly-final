RIE_HOST=0.0.0.0
RIE_PORT=8091
RIE_LOG_LEVEL=INFO
RIE_API_TOKEN=replace-with-a-long-random-service-token

# provider: none | openai-compatible | responses | anthropic
RIE_PROVIDER=none
RIE_MODEL=
RIE_BASE_URL=
RIE_API_KEY=
RIE_TIMEOUT_SECONDS=45
RIE_MAX_REVISIONS=2
RIE_HISTORY_SIZE=20

# Future tool layer. Web is deliberately disabled until a provider is configured.
RIE_ALLOW_EXTERNAL_TOOLS=false
RIE_ALLOW_WEB_SEARCH=false

# Controlled learning / training
RIE_LEARNING_ENABLED=true
RIE_LEARNING_RETRIEVAL_ENABLED=true
RIE_TRAINING_DB_PATH=data/response-intelligence-training.sqlite3
RIE_TRAINING_DATASET_DIR=data/training-datasets
RIE_TRAINING_ADAPTER_DIR=data/model-adapters
# redacted | structure-only | full
RIE_TRAINING_PRIVACY_MODE=redacted
RIE_TRAINING_AUTO_CANDIDATE_QUALITY=0.88
RIE_TRAINING_RETRIEVAL_LIMIT=4
RIE_TRAINING_MIN_SFT_EXAMPLES=25
RIE_TRAINING_MIN_PREFERENCE_EXAMPLES=20
RIE_TRAINING_PREFER_ACTIVE_ADAPTER=false
RIE_LOCAL_ADAPTER_DEVICE_MAP=auto
RIE_LOCAL_ADAPTER_TEMPERATURE=0.55

# Approved institutional/global knowledge retrieval
RIE_KNOWLEDGE_ENABLED=true
RIE_KNOWLEDGE_RETRIEVAL_ENABLED=true
RIE_KNOWLEDGE_DB_PATH=data/response-intelligence-knowledge.sqlite3
RIE_KNOWLEDGE_RETRIEVAL_LIMIT=6
RIE_KNOWLEDGE_INCLUDE_GLOBAL=true
RIE_KNOWLEDGE_MAX_CONTEXT_CHARS=18000
