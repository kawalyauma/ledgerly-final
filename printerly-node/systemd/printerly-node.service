[Unit]
Description=Ledgerly Printerly / Scannerly Node
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
Type=simple
User=printerly
Group=printerly
SupplementaryGroups=lp scanner
Environment=PRINTERLY_CONFIG=/etc/printerly/config.json
Environment=PRINTERLY_STATE_DIR=/var/lib/printerly
ExecStart=/usr/bin/node /opt/printerly/src/agent.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/printerly
ReadWritePaths=/var/lib/printerly

[Install]
WantedBy=multi-user.target
