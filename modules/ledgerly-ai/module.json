{
  "key": "ledgerly-ai",
  "name": "Ledgerly AI",
  "version": "0.19.0",
  "description": "One persistent Ledgerly AI controller for conversations, server operations, project changes and verified rebuilds.",
  "category": "automation",
  "core": true,
  "active": true,
  "manifest": {
    "standalone": true,
    "providers": ["managed-internal"],
    "providerVisibility": "internal-admin-only",
    "features": [
      "global-ask-entry-point",
      "end-user-ai-workspace",
      "recent-saved-chat-history",
      "chat-search",
      "bounded-text-context-attachments",
      "recoverable-retry-flow",
      "tenant-isolation",
      "secret-redaction",
      "private-provider-session-store",
      "prompt-privilege-escalation-defense",
      "single-controller",
      "direct-provider-execution",
      "repository-write-control",
      "automatic-project-rebuild-after-edits",
      "worker-database-secret-isolation",
      "worker-resource-limits",
      "immutable-security-audit",
      "provider-adapter-integration-tests",
      "provider-failover-tests",
      "postgres-persistence-tests",
      "multi-tenant-integration-tests",
      "load-concurrency-tests",
      "dual-provider-failure-recovery-tests",
      "authenticated-e2e-smoke-tests",
      "architecture-documentation",
      "operations-runbook",
      "backup-recovery-guide",
      "provider-policy-documentation",
      "provider-session-runbook",
      "operator-troubleshooting",
      "ai-backup-recovery-runbook",
      "persistent-memory-chat",
      "privileged-provider-health",
      "audit-log-explorer",
      "usage-performance-dashboard"
    ]
  }
}
