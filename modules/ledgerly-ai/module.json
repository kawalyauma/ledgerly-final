{
  "key": "ledgerly-ai",
  "name": "Ledgerly AI",
  "version": "0.14.0",
  "description": "Managed AI control plane for Ledgerly chats, named employees, custom agents, engineering incidents, approvals, memory, tools, monitoring, deployments and admin governance.",
  "category": "automation",
  "core": true,
  "active": true,
  "manifest": {
    "standalone": true,
    "providers": ["managed-internal"],
    "providerVisibility": "internal-admin-only",
    "features": [
      "admin-console",
      "persistent-memory-chat",
      "named-ai-employees",
      "custom-agent-management",
      "engineering-incidents",
      "engineering-job-queue",
      "agent-activity-timeline",
      "approval-inbox",
      "deployment-status",
      "memory-inspector",
      "tool-permission-registry",
      "privileged-provider-health",
      "audit-log-explorer",
      "usage-performance-dashboard",
      "autonomy-pause-controls",
      "emergency-stop"
    ]
  }
}
