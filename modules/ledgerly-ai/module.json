{
  "key": "ledgerly-ai",
  "name": "Ledgerly AI",
  "version": "0.16.0",
  "description": "Managed AI control plane for Ledgerly chats, named employees, custom agents, engineering incidents, approvals, memory, tools, monitoring, deployments and admin governance.",
  "category": "automation",
  "core": true,
  "active": true,
  "manifest": {
    "standalone": true,
    "providers": ["managed-internal"],
    "providerVisibility": "internal-admin-only",
    "features": [
      "admin-console",
      "global-ask-entry-point",
      "end-user-ai-workspace",
      "named-employee-selection",
      "my-ai-employees",
      "recent-saved-chat-history",
      "chat-search",
      "bounded-text-context-attachments",
      "transparent-tool-status",
      "approval-confirmation-ui",
      "recoverable-retry-flow",
      "long-running-task-notifications",
      "tenant-isolation",
      "role-capability-intersection",
      "secret-redaction",
      "private-provider-session-store",
      "prompt-privilege-escalation-defense",
      "tool-boundary-injection-defense",
      "sandboxed-engineering-workers",
      "restricted-worker-filesystem-mounts",
      "worker-database-secret-isolation",
      "engineering-command-allowlist",
      "worker-resource-limits",
      "immutable-security-audit",
      "persistent-memory-chat",
      "named-ai-employees",
      "custom-agent-management",
      "engineering-incidents",
      "engineering-job-queue",
      "agent-activity-timeline",
      "approval-inbox",
      "deployment-status",
      "memory-inspector",
      "tool-permission-registry",
      "privileged-provider-health",
      "audit-log-explorer",
      "usage-performance-dashboard",
      "autonomy-pause-controls",
      "emergency-stop"
    ]
  }
}
