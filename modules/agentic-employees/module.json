{
  "key": "agentic-employees",
  "name": "AI Employees",
  "version": "1.0.0",
  "description": "Tenant-safe agentic school employees powered by OpenAI models with Ledgerly tool controls, approvals and audit trails.",
  "category": "automation",
  "core": false,
  "active": true,
  "manifest": {
    "standalone": true,
    "requiresModules": ["school-management"],
    "requiresDataFrom": ["school-management", "communications", "human-resources"],
    "sharedCore": ["organizations", "users", "school_students", "school_staff_profiles"],
    "provider": "openai-responses",
    "models": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"],
    "agents": ["secretary", "dos", "bursar", "headteacher", "hr", "librarian"],
    "features": [
      "agent-workspaces",
      "bounded-tool-calling",
      "tenant-isolation",
      "human-approval-gates",
      "tool-audit-log",
      "task-execution",
      "model-tier-routing",
      "custom-agent-prompts"
    ]
  }
}
