{
  "key": "agentic-employees",
  "name": "AI Employees",
  "version": "1.2.5",
  "description": "Tenant-safe agentic school employees powered by OpenAI models with Ledgerly tool controls, approvals, proactive reviews, cross-employee delegation and comprehensive family reporting.",
  "category": "automation",
  "core": false,
  "active": true,
  "manifest": {
    "standalone": true,
    "requiresModules": ["school-management"],
    "requiresDataFrom": ["school-management", "academics", "communications", "human-resources", "books", "attendance", "exams"],
    "sharedCore": ["organizations", "users", "school_students", "school_guardians", "school_student_guardians", "school_staff_profiles"],
    "provider": "openai-responses",
    "models": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"],
    "agents": ["secretary", "dos", "bursar", "headteacher", "hr", "librarian"],
    "features": [
      "agent-workspaces",
      "bounded-tool-calling",
      "tenant-isolation",
      "human-approval-gates",
      "tool-audit-log",
      "task-execution",
      "model-tier-routing",
      "custom-agent-prompts",
      "academics-supervision-tools",
      "hr-leave-tools",
      "fees-collection-analysis",
      "books-stock-and-distribution-tools",
      "communications-health-tools",
      "approved-communications-execution",
      "proactive-schedules",
      "proactive-run-history",
      "school-timezone-scheduling",
      "controlled-agent-delegation",
      "headteacher-daily-brief",
      "guardian-family-resolution",
      "cumulative-family-reports",
      "published-results-readonly-analysis",
      "cumulative-attendance-analysis",
      "family-finance-analysis"
    ]
  }
}
