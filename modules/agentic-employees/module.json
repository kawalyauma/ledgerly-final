{
  "key": "agentic-employees",
  "name": "AI Employees",
  "version": "1.4.0",
  "description": "Tenant-safe agentic school employees with proactive reviews, event reactions, bounded delegation and a human-governed Action Center for communications and Tasks & Work follow-up.",
  "category": "automation",
  "core": false,
  "active": true,
  "manifest": {
    "standalone": true,
    "requiresModules": ["school-management"],
    "requiresDataFrom": ["school-management", "academics", "communications", "human-resources", "books", "attendance", "exams", "payroll-payments", "tasks-work"],
    "sharedCore": ["organizations", "users", "school_students", "school_guardians", "school_student_guardians", "school_staff_profiles"],
    "provider": "openai-responses",
    "models": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"],
    "agents": ["secretary", "dos", "bursar", "headteacher", "hr", "librarian"],
    "features": [
      "agent-workspaces",
      "bounded-tool-calling",
      "tenant-isolation",
      "human-approval-gates",
      "tool-audit-log",
      "task-execution",
      "model-tier-routing",
      "custom-agent-prompts",
      "academics-supervision-tools",
      "hr-leave-tools",
      "fees-collection-analysis",
      "books-stock-and-distribution-tools",
      "communications-health-tools",
      "approved-communications-execution",
      "proactive-schedules",
      "proactive-run-history",
      "school-timezone-scheduling",
      "controlled-agent-delegation",
      "headteacher-daily-brief",
      "guardian-family-resolution",
      "cumulative-family-reports",
      "published-results-readonly-analysis",
      "cumulative-attendance-analysis",
      "family-finance-analysis",
      "durable-event-inbox",
      "payment-posted-reactions",
      "absence-escalation",
      "approved-leave-reactions",
      "low-stock-reactions",
      "overdue-lesson-plan-reactions",
      "event-reaction-retries",
      "event-reaction-audit",
      "headteacher-exception-briefing",
      "ai-action-center",
      "event-to-action-proposals",
      "approved-work-task-execution",
      "idempotent-action-execution",
      "conversation-task-preparation"
    ]
  }
}
