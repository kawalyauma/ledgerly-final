# Required after pairing
LEDGERLY_API_URL=https://ledgerly.example.com
CAMERA_SERVER_PAIRING_TOKEN=
CAMERA_LOCAL_BASE_URL=http://192.168.1.20:8789
CAMERA_WEBRTC_BASE_URL=http://192.168.1.20:8889

# Local storage
CAMERA_STORAGE_ROOT=/var/lib/ledgerly-camera/recordings
CAMERA_STORAGE_VOLUMES=
CAMERA_EVIDENCE_ROOT=/var/lib/ledgerly-camera/evidence
CAMERA_SNAPSHOT_ROOT=/var/lib/ledgerly-camera/snapshots
CAMERA_EXPORT_ROOT=/var/lib/ledgerly-camera/exports
CAMERA_SERVER_STATE=/var/lib/ledgerly-camera/server-state.json

# Optional local/NAS backup. Leave blank to disable. CCTV bytes remain outside Ledgerly cloud.
CAMERA_BACKUP_ROOT=
CAMERA_BACKUP_STATE=/var/lib/ledgerly-camera/backup-state.json
CAMERA_BACKUP_INTERVAL_MS=60000
CAMERA_BACKUP_MAX_PER_RUN=20
CAMERA_BACKUP_RETENTION_DAYS=90

# Protect local administrative/detector endpoints with separate long random values.
CAMERA_SERVER_KEY=replace-me
CAMERA_EVENT_KEY=replace-me-too
CAMERA_DETECTOR_MEDIA_KEY=replace-me-detector-read

CAMERA_RETENTION_DAYS=30
CAMERA_MAX_STORAGE_PERCENT=90
CAMERA_MOTION_SCENE_THRESHOLD=0.18
CAMERA_MOTION_SCAN_MS=30000
CAMERA_VALIDATION_INTERVAL_MS=1800000

# Optional secure remote endpoints. Prefer VPN/private tunnel.
CAMERA_WEBRTC_PUBLIC_BASE_URL=
CAMERA_CONTROL_PUBLIC_BASE_URL=

# Optional detector sidecar
CAMERA_DETECTOR_MODEL=
CAMERA_DETECTOR_CONFIDENCE=0.55
CAMERA_DETECTOR_INTERVAL_SECONDS=1
CAMERA_DETECTOR_COOLDOWN_SECONDS=10
CAMERA_DETECTOR_OBJECT_CLASSES=person,car,bus,truck,motorcycle,bicycle
