[Unit]
Description=Ledgerly scheduled jobs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ledgerly
Group=ledgerly
WorkingDirectory=/opt/ledgerly
EnvironmentFile=/etc/ledgerly/ledgerly.env
ExecStart=/usr/bin/npm run start:scheduler
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ledgerly

[Install]
WantedBy=multi-user.target
