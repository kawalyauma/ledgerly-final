# Core runtime
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8787
DATABASE_URL=postgresql://ledgerly:change-me@127.0.0.1:5432/ledgerly
PG_POOL_MAX=20
PG_SSL=false
STORAGE_ROOT=/var/lib/ledgerly/storage
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=your-finance-pro
JWT_AUDIENCE=your-finance-pro-api

# Durable queue worker
QUEUE_POLL_MS=1000
QUEUE_BATCH_SIZE=20

# Optional integrations
WHATSAPP_SUPPORT_HUB_URL=
WHATSAPP_SUPPORT_APP_KEY=
WHATSAPP_SUPPORT_WEBHOOK_SECRET=
EGOSMS_API_URL=https://www.egosms.co/api/v1/plain/
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
EGOSMS_SENDER_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BIOMETRIC_ENCRYPTION_KEY=
